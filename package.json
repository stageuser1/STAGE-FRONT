{
  "name": "stage-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "build": "next build && node scripts/assert-artifact.mjs",
    "build:clean": "npm run clean && npm run build",
    "start": "next start",
    "typecheck": "npm run clean && tsc --noEmit",
    "typecheck:incremental": "tsc --noEmit",
    "test:validator": "python -m unittest tests.test_validator -v",
    "test:importer": "node --test tests/import_package.test.mjs tests/import_v4_package.test.mjs",
    "test:lib": "node --test --experimental-strip-types tests/ielts_*.test.mjs tests/fit_*.test.mjs tests/profile_*.test.mjs tests/search_*.test.mjs tests/dashboard_*.test.mjs",
    "test": "npm run test:validator && npm run test:importer && npm run test:lib",
    "smoke": "node scripts/smoke.mjs",
    "guard": "node scripts/guard.mjs"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.3"
  }
}
