{
  "//": "Topic assignment rules for import-speaking-recalls.mjs. Ordered: the first rule with a matching pattern wins, so put narrow topics (tall building, favorite city) above broad ones (cities). Patterns are case-insensitive regexes tested against the question text (Part 2: prompt + cue points). Edit this file, not the script, when a new season introduces new topics.",
  "sourceStatement": "题目基于考生回忆整理（2026 年 2–7 月场次），题干为考生回忆的转述文字，非官方试题原文；话题分类、话题中文名与中文注解为 STAGE 编辑撰写。保留的少量自撰话题在该话题的 sourceNote 中单独标明。",
  "recallSourceNote": "考生回忆整理，2026 年 2–7 月场次（2026-05—08 换题季）",
  "//mergeSelfInto": "Self-authored topics folded into a recall topic instead of deleted: their questions that are not verbatim duplicates of a recall question are appended (keeping their original ids, no recall fields).",
  "mergeSelfInto": {
    "friends": "friends-and-family",
    "money-and-saving": "money-and-gifts"
  },
  "keepSelfAuthoredTopics": [
    "weather-and-seasons",
    "sleep",
    "photography",
    "languages",
    "celebrations",
    "education"
  ],
  "proceduralDrops": [
    "what is your full name",
    "may i see your id",
    "can you tell me your full name",
    "where are you from"
  ],
  "//fragmentDrops": "Normalized keys of items that parse as questions but are compressed recall fragments (checked by hand against the source). Kept out of the corpus, listed in the report.",
  "fragmentDrops": [
    "how diets have changed",
    "how to avoid feeling bored"
  ],
