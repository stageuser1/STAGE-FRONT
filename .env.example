# OSS 数据真相源(私有 bucket,oss-cn-hongkong;凭据仅服务端,严禁 NEXT_PUBLIC_)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hongkong
# draft 预览令牌(?preview=<token>);与 SCHOOLS_WRITE_TOKEN 必须不同值
PREVIEW_TOKEN=
# 写入 API 鉴权(POST /api/schools 与 publish/unpublish);独立随机串,勿与 PREVIEW_TOKEN 相同
SCHOOLS_WRITE_TOKEN=

# Growth ingest endpoint on the Staff platform (stage-staff /api/ingest).
# Unset — as it is here and in every local checkout — makes lib/growth a total
# no-op: no visitor id, no storage read, no network attempt.
NEXT_PUBLIC_GROWTH_INGEST_URL=
